<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Umbraco.Community.ModelAliases</Product>
    <PackageId>Umbraco.Community.ModelAliases</PackageId>
    <Title>Model Aliases</Title>
    <Description>Generates a constants class of property aliases for every Umbraco Models Builder model, so ContentPage.Aliases.Title is "title".</Description>
    <PackageTags>umbraco;modelsbuilder</PackageTags>
    <Authors>Matt Bliss</Authors>
    <Copyright>$([System.DateTime]::UtcNow.ToString(`yyyy`)) © Matt Bliss</Copyright>
    <PackageProjectUrl>https://github.com/mttblss/Umbraco.Community.ModelAliases</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mttblss/Umbraco.Community.ModelAliases</RepositoryUrl>
    <PackageReadmeFile>README_nuget.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon></PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Core" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\README_nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
